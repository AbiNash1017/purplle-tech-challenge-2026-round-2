# =============================================================================
# Store Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Local (requires a replica set if you want change streams):
MONGO_URI=mongodb://localhost:27017/store_intelligence?replicaSet=rs0

# MongoDB Atlas (cloud — no replica set config needed):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/store_intelligence?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Upstash Redis (used for idempotency keys, heartbeats, and activity tracking)
# ---------------------------------------------------------------------------
# The app uses Upstash via its HTTP REST API — no TCP socket or local Redis needed.
# Leave both blank to run fully offline with the in-memory fallback (recommended for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# To use Upstash cloud, fill these in from your Upstash console:
# UPSTASH_REDIS_REST_URL=https://<your-endpoint>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your-token>

# ---------------------------------------------------------------------------
# CV Pipeline Execution Mode
# ---------------------------------------------------------------------------
# SIMULATED: Reads pre-processed JSONL files from store-intelligence/pipeline/data/output/
# LIVE:      Connects to real cameras and runs YOLO inference (requires GPU + camera setup)
EXECUTION_MODE=SIMULATED

# ---------------------------------------------------------------------------
# Backend API URL (used by the CV pipeline simulator to POST events)
# ---------------------------------------------------------------------------
API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Dashboard (Next.js) — these are set in dashboard/.env.local, not here
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
# ---------------------------------------------------------------------------
